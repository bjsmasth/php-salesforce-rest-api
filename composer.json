{
  "name": "bjsmasth/php-salesforce-rest-api",
  "description": "Simple PHP client for the Salesforce REST API",
  "license": "MIT",
  "keywords": [
    "bjsmasth",
    "php salesforce",
    "php salesforce rest",
    "php salesforce rest api",
    "php"
  ],
  "authors": [
    {
      "name": "Bijesh Shrestha",
      "email": "bjsmasth@gmail.com",
      "homepage": "https://github.com/bjsmasth"
    }
  ],
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "bjsmasth\\Salesforce\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "bjsmasth\\Salesforce\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
